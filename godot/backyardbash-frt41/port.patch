+extends SceneTree
+var game
+var failed := false
+func _initialize() -> void:
+	call_deferred("_run")
+func check(ok: bool, label: String) -> void:
+	print("FRT_CHECK %s %s" % ["PASS" if ok else "FAIL", label])
+	if not ok:
+		failed = true
+func key(code: int, pressed: bool) -> void:
+	var event := InputEventKey.new()
+	event.keycode = code
+	event.physical_keycode = code
+	event.pressed = pressed
+	Input.parse_input_event(event)
+	if DisplayServer.get_name() == "headless":
+		root.push_input(event)
+func tap(code: int) -> void:
+	key(code, true)
+	await create_timer(0.12).timeout
+	key(code, false)
+	await create_timer(0.12).timeout
+func _run() -> void:
+	change_scene_to_file("res://scenes/main.tscn")
+	await process_frame
+	await process_frame
+	game = current_scene
+	check(game != null, "scene")
+	var initial_mode: int = game.selected_mode
+	await tap(KEY_RIGHT)
+	check(game.selected_mode == posmod(initial_mode + 1, 3), "mode right")
+	await tap(KEY_LEFT)
+	check(game.selected_mode == initial_mode, "mode left")
+	while game.selected_mode != 0:
+		await tap(KEY_LEFT)
+	await tap(KEY_DOWN)
+	await tap(KEY_UP)
+	check(game.menu_row == 0, "menu up")
+	await tap(KEY_ENTER)
+	check(game.state == game.GameState.GARAGE, "A joins garage")
+	await tap(KEY_RIGHT)
+	check(game.joined_players[0].variant == 1, "garage truck choice")
+	await tap(KEY_ENTER)
+	await create_timer(7.0).timeout
+	check(game.state == game.GameState.PLAYING, "A starts round")
+	var start: Vector3 = game.truck.global_position
+	key(KEY_ENTER, true)
+	await create_timer(2.0).timeout
+	print("DRIVE_DIAG pressed=%s keyboard=%s enabled=%s throttle=%s speed=%s from=%s to=%s" % [Input.is_key_pressed(KEY_ENTER), game.truck.keyboard_control, game.truck.controls_enabled, game.truck.throttle, game.truck.drive_speed, start, game.truck.global_position])
+	key(KEY_ENTER, false)
+	check(game.truck.global_position.distance_to(start) > 1.0, "A accelerates")
+	key(KEY_BACKSPACE, true)
+	await create_timer(2.0).timeout
+	key(KEY_BACKSPACE, false)
+	check(game.truck.drive_speed < 0.0, "B reverses")
+	await tap(KEY_SPACE)
+	check(game.truck.horn_player.playing, "X horn")
+	await tap(KEY_P)
+	check(paused, "Start pauses")
+	await tap(KEY_BACKSPACE)
+	check(not paused, "B resumes")
+	game._open_customizer(0)
+	await tap(KEY_DOWN)
+	await tap(KEY_RIGHT)
+	await tap(KEY_E)
+	await tap(KEY_ENTER)
+	check(game.customizer_owner == -1, "customizer keyboard save")
+	for mode in 3:
+		game.selected_mode = mode
+		game._restart_game()
+		game._start_round()
+		game.truck.set_test_controls(true, 0.35, 1.0, 0.0)
+		var frames := Engine.get_process_frames()
+		var begin := Time.get_ticks_msec()
+		await create_timer(8.0).timeout
+		var elapsed := (Time.get_ticks_msec() - begin) / 1000.0
+		print("FRT_BENCH mode=%d fps=%.2f score=%s calls=%s primitives=%s process_ms=%.2f physics_ms=%.2f" % [mode, (Engine.get_process_frames() - frames) / elapsed, game.player_scores, Performance.get_monitor(Performance.RENDER_TOTAL_DRAW_CALLS_IN_FRAME), Performance.get_monitor(Performance.RENDER_TOTAL_PRIMITIVES_IN_FRAME), Performance.get_monitor(Performance.TIME_PROCESS)*1000, Performance.get_monitor(Performance.TIME_PHYSICS_PROCESS)*1000])
+		game.truck.set_test_controls(false)
+		if DisplayServer.get_name() != "headless":
+			root.get_texture().get_image().save_png("user://frt-mode-%d.png" % mode)
+		if mode == 0:
+			var target
+			for car in game.toy_cars:
+				if not car.is_crushed:
+					target = car
+					break
+			if target:
+				target.force_crush(game.truck)
+			await create_timer(0.2).timeout
+			check(game.hud.crush_count == game.crush_count and game.hud.player_scores == game.player_scores, "HUD score propagation")
+	print("FRT_CHECK_COMPLETE failed=%s" % failed)
+	if failed:
+		game._cleanup_for_exit()
+		quit(1)
+		return
+	await tap(KEY_ESCAPE)
+	check(false, "Escape failed to quit")
+	quit(1)
