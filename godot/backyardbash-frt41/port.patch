@@ -0,0 +1,45 @@
+extends RefCounted
+# Bake rigid visual parts into one vertex-colored mesh. Physics nodes remain intact.
+static func merge(root: Node3D, parts: Array) -> void:
+	if parts.is_empty():
+		return
+	var surface := SurfaceTool.new()
+	surface.begin(Mesh.PRIMITIVE_TRIANGLES)
+	var to_local := root.global_transform.affine_inverse()
+	for part in parts:
+		var node := part as MeshInstance3D
+		if node == null or node.mesh == null:
+			continue
+		var material := node.material_override as StandardMaterial3D
+		if material == null:
+			continue
+		var transform := to_local * node.global_transform
+		for index in node.mesh.get_surface_count():
+			var arrays := node.mesh.surface_get_arrays(index)
+			var vertices: PackedVector3Array = arrays[Mesh.ARRAY_VERTEX]
+			var colors := PackedColorArray()
+			colors.resize(vertices.size())
+			var normals := PackedVector3Array()
+			if arrays[Mesh.ARRAY_NORMAL] != null:
+				normals = arrays[Mesh.ARRAY_NORMAL]
+			var normal_basis := transform.basis.inverse().transposed()
+			for v in vertices.size():
+				var normal := (normal_basis * normals[v]).normalized() if v < normals.size() else Vector3.UP
+				var brightness := 0.65 + 0.35 * maxf(0.0, normal.dot(Vector3(-0.4, 0.8, 0.3).normalized()))
+				colors[v] = Color(material.albedo_color.r * brightness, material.albedo_color.g * brightness, material.albedo_color.b * brightness, material.albedo_color.a)
+			arrays[Mesh.ARRAY_COLOR] = colors
+			var colored := ArrayMesh.new()
+			colored.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arrays)
+			surface.append_from(colored, 0, transform)
+		node.visible = false
+		node.queue_free()
+	var material := StandardMaterial3D.new()
+	material.vertex_color_use_as_albedo = true
+	material.roughness = 0.85
+	material.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
+	material.cull_mode = BaseMaterial3D.CULL_DISABLED
+	var merged := MeshInstance3D.new()
+	merged.name = "HandheldBatchedVisual"
+	merged.mesh = surface.commit()
+	merged.material_override = material
+	root.add_child(merged)
