+extends SceneTree
+func _initialize() -> void:
+	DirAccess.make_dir_recursive_absolute("res://assets/generated")
+	var factory = preload("res://src/audio_factory.gd")
+	var streams := {
+		"engine_loop": factory.engine_loop(), "horn": factory.horn(),
+		"crunch": factory.crunch(), "jump": factory.jump(),
+		"recover": factory.recover(), "cheer": factory.cheer(),
+		"reward": factory.reward(), "music_loop": factory.music_loop(),
+	}
+	for name in streams:
+		var error := ResourceSaver.save(streams[name], "res://assets/generated/%s.res" % name)
+		if error != OK:
+			push_error("AUDIO_BAKE_FAILED %s error=%d" % [name, error])
+			quit(1)
+			return
+	print("AUDIO_BAKE_PASS count=%d" % streams.size())
+	quit(0)
