+# Keep the original material resources so paint changes still update every part.
+static func merge_materials(root: Node3D, parts: Array) -> void:
+	var groups := {}
+	var to_local := root.global_transform.affine_inverse()
+	for part in parts:
+		var node := part as MeshInstance3D
+		if node == null or node.mesh == null or node.material_override == null:
+			continue
+		var material: Material = node.material_override
+		if not groups.has(material):
+			var surface := SurfaceTool.new()
+			surface.begin(Mesh.PRIMITIVE_TRIANGLES)
+			groups[material] = surface
+		var surface: SurfaceTool = groups[material]
+		for index in node.mesh.get_surface_count():
+			surface.append_from(node.mesh, index, to_local * node.global_transform)
+		node.visible = false
+		node.queue_free()
+	for material in groups:
+		var merged := MeshInstance3D.new()
+		merged.mesh = groups[material].commit()
+		merged.material_override = material
+		root.add_child(merged)
